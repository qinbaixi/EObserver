{erl_opts, [debug_info, warn_unused_vars, warn_shadow_vars, warn_obsolete_guard]}.

{deps, [
    {cowboy, {git, "https://github.com/ninenines/cowboy.git", {tag, "2.12.0"}}},
    {jsx, {git, "https://github.com/talentdeficit/jsx.git", {tag, "v3.1.0"}}}
]}.

{project_app_dirs, ["apps/*"]}.

{relx, [
    {release, {eobserver, "0.0.8"}, [eobserver, sasl]},
    {mode, prod},
    %% Keep debug_info: the agent is recompiled on targets whose OTP cannot
    %% load our beam and has no precompiled one.
    {debug_info, keep},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {overlay, [
        {copy, "scripts/eobs", "bin/eobs"},
        {copy, "scripts/eobs.cmd", "bin/eobs.cmd"}
    ]}
]}.

{profiles, [
    {test, [{erl_opts, [nowarn_export_all]}]}
]}.

{shell, [{config, "config/sys.config"}, {apps, [eobserver]}]}.

{ct_opts, [{sys_config, ["config/sys.config"]}]}.
